{
  "name": "my-video-app",
  "version": "1.12.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "verify": "npm run typecheck && npm run check:source && npm test && npm run test:native && npm run build && npm run test:browser",
    "package": "node scripts/package.mjs",
    "test:http3": "node tests/http3.mjs",
    "test:native": "node scripts/test-native.mjs",
    "bench:algorithms": "node scripts/benchmark.mjs",
    "check:source": "node scripts/audit-source.mjs",
    "check:dependencies": "node scripts/audit-dependencies.mjs",
    "encrypt:source": "node scripts/encrypt-source.mjs encrypt",
    "decrypt:source": "node scripts/encrypt-source.mjs decrypt"
  },
  "devDependencies": {
    "@ffmpeg/core": "0.12.10",
    "@types/chrome": "0.3.5",
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "playwright-core": "1.64.1",
    "typescript": "5.9.3"
  }
}
