{
  "manifest_version": 3,
  "name": "My Video App",
  "short_name": "My Video App",
  "version": "1.14.1",
  "version_name": "1.14.1 · 개인용 로컬 버전",
  "description": "계정·구독 없이 미디어를 감지하고 다운로드하며, 기록과 업스케일링을 브라우저 안에서 처리합니다.",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "assets/cdcd9d4f6e5bec5750303506aaa4be78.js",
    "type": "module"
  },
  "action": {
    "default_title": "My Video App",
    "default_popup": "assets/1db982ec0a06958b093fe6a753fab913.html",
    "default_icon": {
      "128": "assets/2d11038a2bafe4ddbcf038242fa4986d.png"
    }
  },
  "icons": {
    "128": "assets/2d11038a2bafe4ddbcf038242fa4986d.png"
  },
  "side_panel": {
    "default_path": "assets/fe160f2cdf0af7033b4f0745f5704bf9.html"
  },
  "options_ui": {
    "page": "assets/fe160f2cdf0af7033b4f0745f5704bf9.html",
    "open_in_tab": true
  },
  "permissions": [
    "tabs",
    "webRequest",
    "downloads",
    "storage",
    "unlimitedStorage",
    "offscreen",
    "sidePanel",
    "notifications",
    "contextMenus"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "assets/87a6a2ea7ef07c15f4160dea535e1e24.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; connect-src 'self' http: https:; img-src 'self' blob: data:; media-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Up",
        "mac": "Ctrl+Shift+Up"
      }
    },
    "default-action": {
      "suggested_key": {
        "default": "Alt+Down",
        "mac": "Ctrl+Shift+Down"
      },
      "description": "현재 탭의 첫 미디어 다운로드"
    }
  },
  "incognito": "split"
}
