{
  "manifest_version": 3,
  "name": "My Video App",
  "short_name": "My Video App",
  "version": "1.16.0",
  "version_name": "1.16.0 · 개인용 로컬 버전",
  "description": "계정·구독 없이 미디어를 감지하고 다운로드하며, 기록과 업스케일링을 브라우저 안에서 처리합니다.",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "assets/78aeade32c885e86e0370cc6946026ec.js",
    "type": "module"
  },
  "action": {
    "default_title": "My Video App",
    "default_popup": "assets/4e38d5b5f99498b684aa0eec68bdfd9d.html",
    "default_icon": {
      "128": "assets/04d80c026f275b0de57d8c64af592a47.png"
    }
  },
  "icons": {
    "128": "assets/04d80c026f275b0de57d8c64af592a47.png"
  },
  "side_panel": {
    "default_path": "assets/3644aaf47968d9a3d56a2cbe948aea68.html"
  },
  "options_ui": {
    "page": "assets/3644aaf47968d9a3d56a2cbe948aea68.html",
    "open_in_tab": true
  },
  "permissions": [
    "tabs",
    "webRequest",
    "downloads",
    "storage",
    "unlimitedStorage",
    "offscreen",
    "sidePanel",
    "notifications",
    "contextMenus"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "assets/1b7239738bd5c0dc2dcc31d8f07571f9.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; connect-src 'self' http: https:; img-src 'self' blob: data:; media-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Up",
        "mac": "Ctrl+Shift+Up"
      }
    },
    "default-action": {
      "suggested_key": {
        "default": "Alt+Down",
        "mac": "Ctrl+Shift+Down"
      },
      "description": "현재 탭의 첫 미디어 다운로드"
    }
  },
  "incognito": "split"
}
