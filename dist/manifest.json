{
  "manifest_version": 3,
  "name": "My Video App",
  "short_name": "My Video App",
  "version": "1.14.0",
  "version_name": "1.14.0 · 개인용 로컬 버전",
  "description": "계정·구독 없이 미디어를 감지하고 다운로드하며, 기록과 업스케일링을 브라우저 안에서 처리합니다.",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "assets/729d7c2b88720b94dfee5da7755a3a50.js",
    "type": "module"
  },
  "action": {
    "default_title": "My Video App",
    "default_popup": "assets/b12f7f5ff2ff3722a72b3b8798d054b4.html",
    "default_icon": {
      "128": "assets/0b26bb85bf9fbde2fbbaf7653bd3eac2.png"
    }
  },
  "icons": {
    "128": "assets/0b26bb85bf9fbde2fbbaf7653bd3eac2.png"
  },
  "side_panel": {
    "default_path": "assets/847c5fbb8f4137b16e68f79678013309.html"
  },
  "options_ui": {
    "page": "assets/847c5fbb8f4137b16e68f79678013309.html",
    "open_in_tab": true
  },
  "permissions": [
    "tabs",
    "webRequest",
    "downloads",
    "storage",
    "unlimitedStorage",
    "offscreen",
    "sidePanel",
    "notifications",
    "contextMenus"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "assets/3f49d8e0a82fd208c0a27662b6ac4c15.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; connect-src 'self' http: https:; img-src 'self' blob: data:; media-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Up",
        "mac": "Ctrl+Shift+Up"
      }
    },
    "default-action": {
      "suggested_key": {
        "default": "Alt+Down",
        "mac": "Ctrl+Shift+Down"
      },
      "description": "현재 탭의 첫 미디어 다운로드"
    }
  },
  "incognito": "split"
}
