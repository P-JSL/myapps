{
  "manifest_version": 3,
  "name": "My Video App",
  "short_name": "My Video App",
  "version": "1.20.6",
  "version_name": "1.20.6 · 개인용 로컬 버전",
  "description": "계정·구독 없이 미디어를 감지하고 다운로드하며, 기록과 업스케일링을 브라우저 안에서 처리합니다.",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "assets/58c8f81fcbf4ac1dd492fe0db7fab41f.js",
    "type": "module"
  },
  "action": {
    "default_title": "My Video App",
    "default_popup": "assets/7f014e47a9b49876ff471e2bf0f78df3.html",
    "default_icon": {
      "128": "assets/a5edbf3ddc888cdb77c35cc2af5e2281.png"
    }
  },
  "icons": {
    "128": "assets/a5edbf3ddc888cdb77c35cc2af5e2281.png"
  },
  "side_panel": {
    "default_path": "assets/8dd359fc9fe789de4a3b94e6cd417338.html"
  },
  "options_ui": {
    "page": "assets/8dd359fc9fe789de4a3b94e6cd417338.html",
    "open_in_tab": true
  },
  "permissions": [
    "tabs",
    "webRequest",
    "downloads",
    "storage",
    "unlimitedStorage",
    "offscreen",
    "sidePanel",
    "notifications",
    "contextMenus"
  ],
  "optional_permissions": [
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "assets/913c85b89f2535a2e3708138a7cb4058.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; connect-src 'self' http: https:; img-src 'self' blob: data:; media-src 'self' blob:; object-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Up",
        "mac": "Ctrl+Shift+Up"
      }
    },
    "default-action": {
      "suggested_key": {
        "default": "Alt+Down",
        "mac": "Ctrl+Shift+Down"
      },
      "description": "현재 탭의 첫 미디어 다운로드"
    }
  },
  "incognito": "split",
  "message_serialization": "structured_clone"
}
